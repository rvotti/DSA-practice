{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: build",
      "type": "shell",
      "command": "g++",
      "args": [
        "${file}",
        "-o",
        "${workspaceFolder}/butterfly.exe",
        "-g"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
